[Desktop Entry]
Version=1.5
Type=Application
Name=LinScreenCapture
GenericName=Screenshot Tool
Comment=Capture, annotate and share screenshots · PrintScreen copies a region to the clipboard
Exec=@BIN@
Icon=com.mensuramedia.LinScreenCapture
Terminal=false
Categories=Utility;Graphics;GTK;
Keywords=screenshot;capture;screen;snip;annotation;printscreen;
StartupNotify=true
StartupWMClass=com.mensuramedia.LinScreenCapture
Actions=capture;

[Desktop Action capture]
Name=Capture a region
Exec=@BIN@ --capture
