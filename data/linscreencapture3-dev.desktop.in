[Desktop Entry]
Version=1.5
Type=Application
Name=LinScreenCapture3
GenericName=Screenshot Tool (development build)
Comment=LinScreenCapture 3 — Studio Editor, running from the source checkout · PrintScreen copies a region to the clipboard
Exec=@ROOT@/tools/launch.sh
Icon=com.mensuramedia.LinScreenCapture
Terminal=false
Categories=Utility;GTK;
Keywords=screenshot;capture;screen;snip;annotation;
StartupNotify=true
StartupWMClass=com.mensuramedia.LinScreenCapture
Actions=capture;

[Desktop Action capture]
Name=Capture a region
Exec=@ROOT@/tools/launch.sh --capture
